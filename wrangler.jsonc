{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "staging",
    "main": "workers/app.js",
    "compatibility_date": "2026-11-01",
    "assets": {
        "directory": "./public/build",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*", "/build/*"]
    },
    "observability": {
        "enabled": true
    },
    "placement": {
        "mode": "smart"
    }
    // BACKEND_URL — the Laravel origin (Laravel Cloud, Forge/VPS, container…) that serves
    // every dynamic request, including sign-in, the partner portal and the Super Admin CMS.
    // Set it as a secret, never a placeholder:  npx wrangler secret put BACKEND_URL
    // Without it the worker only serves public pages from bundled default content.
}
