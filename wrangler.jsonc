{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "ravu-website",
    "main": "workers/app.js",
    "compatibility_date": "2026-11-01",
    "assets": {
        "directory": "./public/build",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*", "/build/*"]
    },
    "observability": {
        "enabled": true
    },
    "placement": {
        "mode": "smart"
    },
    "vars": {
        // Where the Laravel PHP backend lives (Laravel Cloud, Forge/VPS, container, ...)
        // Prefer a secret instead:  npx wrangler secret put BACKEND_URL
        "BACKEND_URL": "https://backend.example.com"
    }
}
