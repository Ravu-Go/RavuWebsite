APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Partner onboarding policies must point to public, current policy pages.
PARTNER_TERMS_URL=
PARTNER_PRIVACY_URL=
PARTNER_TERMS_VERSION=v1
PARTNER_PRIVACY_VERSION=v1

# Super admins come from database/seeders/SuperAdminSeeder.php, which prints one-time passwords.

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="/auth/google/callback"

# ---------------------------------------------------------------------------
# Cloudflare deployment (Workers edge / Pages)
# ---------------------------------------------------------------------------
# Trusted proxies so Laravel honors CF-Connecting-IP from the edge worker.
TRUSTED_PROXIES=*
# Public asset base URL — the Workers/Pages asset host (optional; blank = same origin)
ASSET_URL=

# Membership revenue on the Super Admin "Revenue" page: "demo" (sample data),
# "database" (the RAVU app's own database, read-only) or "api".
MEMBERSHIP_REVENUE_SOURCE=demo
MEMBERSHIP_API_URL=
MEMBERSHIP_API_TOKEN=

# Disk for images uploaded through the Super Admin CMS (run `php artisan storage:link` for "public").
# Use an S3-compatible disk in production if the server filesystem is not persistent.
SITE_MEDIA_DISK=public

# Partner payouts & member lookups
PARTNER_PAYOUT_POOL_PERCENT=30
PARTNER_VOID_WINDOW_HOURS=24
MEMBERSHIP_MEMBER_SOURCE=demo

# The RAVU app's database (ravu-api PostgreSQL), read-only. Used when the two
# sources above are "database". See README "Connecting the RAVU app".
RAVU_API_DB_HOST=
RAVU_API_DB_PORT=5432
RAVU_API_DB_DATABASE=ravu
RAVU_API_DB_USERNAME=ravu_website_ro
RAVU_API_DB_PASSWORD=
RAVU_API_DB_SSLMODE=require
# Count the app's simulated (test) payments as income. Defaults to on outside production.
# MEMBERSHIP_DB_INCLUDE_SIMULATED=false

# Sign in against the RAVU app's own users table (ravu-api PostgreSQL) instead of a
# website-only users table. The website's tables then live in their own schema:
#   DB_SEARCH_PATH="website,public"   (run: CREATE SCHEMA website; then php artisan migrate)
# Registration also adds a draft partner to the app's partners table.
# App users with a role in RAVU_APP_SUPER_ADMIN_ROLES open the Super Admin dashboard.
# Defaults: DB_SEARCH_PATH="website,public"; RAVU_APP_SHARED_ACCOUNTS is detected
# (on when "users" resolves to the app's public.users). Set either to override.
# DB_SEARCH_PATH="website,public"
# RAVU_APP_SHARED_ACCOUNTS=true
RAVU_APP_PARTNERS_TABLE=public.partners
RAVU_APP_PARTNER_ROLE=merchant
RAVU_APP_SUPER_ADMIN_ROLES=administrator
