APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Partner onboarding policies must point to public, current policy pages.
PARTNER_TERMS_URL=
PARTNER_PRIVACY_URL=
PARTNER_TERMS_VERSION=v1
PARTNER_PRIVACY_VERSION=v1

# Super admins come from database/seeders/SuperAdminSeeder.php, which prints one-time passwords.

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="/auth/google/callback"

# ---------------------------------------------------------------------------
# Cloudflare deployment (Workers edge / Pages)
# ---------------------------------------------------------------------------
# Trusted proxies so Laravel honors CF-Connecting-IP from the edge worker.
TRUSTED_PROXIES=*
# Public asset base URL — the Workers/Pages asset host (optional; blank = same origin)
ASSET_URL=

# Membership revenue on the Super Admin "Revenue" page: "demo" (sample data) or "api".
MEMBERSHIP_REVENUE_SOURCE=demo
MEMBERSHIP_API_URL=
MEMBERSHIP_API_TOKEN=

# Disk for images uploaded through the Super Admin CMS (run `php artisan storage:link` for "public").
# Use an S3-compatible disk in production if the server filesystem is not persistent.
SITE_MEDIA_DISK=public
